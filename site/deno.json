{
  "lock": false,
  "nodeModulesDir": "auto",
  "allowScripts": [
    "npm:workerd"
  ],
  "tasks": {
    "data": "deno run -A tools/build_data.ts",
    "build": "deno task data && vite build",
    "spa": "vite",
    "dev": "wrangler dev",
    "check": "tsc --noEmit && deno check tools/build_data.ts tools/check_data.ts && deno task check:data",
    "deploy": "vite build && wrangler deploy",
    "check:data": "deno run -A tools/check_data.ts"
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.1.6"
  }
}