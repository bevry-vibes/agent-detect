# =====================================
# CUSTOM

# zig build caches and outputs (binaries ship via CI artifacts, see .github/workflows/build.yml)
.zig-cache/
zig-out/
bin/
# zig dependency package cache (populated by `zig fetch`; not committed, regenerated on demand)
zig-pkg/

# dev daemon telemetry (written by `fixtures daemon --write-log`; already
# covered by **/*.log above, listed explicitly for discoverability)
fixtures/daemon.log
# dev daemon control file (pause/resume/stop; written by the user, cleared
# by the daemon after acting — never committed)
fixtures/daemon.ctl
# per-capture worker logs (the worker's stderr; teed reference is the
# daemon.log, the logs are a scratch record — never committed)
fixtures/tmp/

# index.json store runtime files — the lock file and the atomic-write
# temp file are never committed; `fixtures/index.json` itself IS
# committed (the cross-host work queue + failure memory; see DESIGN.md
# "the state split"). The old sqlite store and its journals are
# ignored for hygiene (long removed).
fixtures/index.json.lock
fixtures/index.json.tmp
fixtures/index.sqlite3*
fixtures/index.sqlite3-*

# ignore codewhale files
.codewhale/state/subagents.v1.json
.codewhale/state/subagent-transcripts/1582a76ef2a920d8343028b0135bde1c92a993feb845e6fe28ec7b33479378c4.jsonl
