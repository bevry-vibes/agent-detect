# 2020 June 3
# https://github.com/bevry/base

# System Files
**/.DS_Store

# Temp Files
**/.docpad.db
**/*.log
**/*.lock
**/*.cpuprofile
**/*.heapsnapshot

# Editor Files
.c9/
.vscode/

# Yarn Files
.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*
.pnp/

# Private Files
.env
.idea
.cake_task_cache

# Build Caches
build/
bower_components/
node_modules/
.next/

# -------------------------------------
# CDN Inclusions, Git Exclusions

# Build Outputs
**/out.*
**/*.out.*
**/out/
**/output/
*compiled*
edition*/
coffeejs/
coffee/
es5/
es2015/
esnext/
docs/

# =====================================
# CUSTOM

# zig build caches and outputs (binaries ship via CI artifacts, see .github/workflows/build.yml)
.zig-cache/
zig-out/
bin/

# dev daemon telemetry (written by `known daemon --write-log`; already
# covered by **/*.log above, listed explicitly for discoverability)
known/daemon.log

# SQLite index/queue DB (written/read via the `sqlite3` CLI; carries
# per-host queue state and fixture history — never committed)
known/*.sqlite3
known/*.sqlite3-journal
known/*.sqlite3-wal
known/*.sqlite3-shm
