# System Files
**/.DS_Store

# Temp Files
**/.docpad.db
**/*.log
**/*.lock
**/*.cpuprofile
**/*.heapsnapshot

# Editor Files
.c9/
.vscode/

# Yarn Files
.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*
.pnp/

# Private Files
.env
.idea
.cake_task_cache

# Build Caches
build/
bower_components/
node_modules/
.next/

# -------------------------------------
# CDN Inclusions, Git Exclusions

# Build Outputs
**/out.*
**/*.out.*
**/out/
**/output/
*compiled*
edition*/
coffeejs/
coffee/
es5/
es2015/
esnext/

# =====================================
# CUSTOM

# zig build caches and outputs (binaries ship via CI artifacts, see .github/workflows/build.yml)
.zig-cache/
zig-out/
bin/
# zig dependency package cache (populated by `zig fetch`; not committed, regenerated on demand)
zig-pkg/

# dev daemon telemetry (written by `fixtures daemon --write-log`; already
# covered by **/*.log above, listed explicitly for discoverability)
fixtures/daemon.log
# dev daemon control file (pause/resume/stop; written by the user, cleared
# by the daemon after acting — never committed)
fixtures/daemon.ctl

# SQLite fixtures/queue DB — COMMITTED (the cross-host work queue + state;
# see DESIGN.md "SQLite state store"). Journals and the daemon's
# telemetry/control files are never committed.
fixtures/index.sqlite3-journal
fixtures/index.sqlite3-wal
fixtures/index.sqlite3-shm
